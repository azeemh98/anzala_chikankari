# Copy to .env and fill in for production.

PORT=3000
NODE_ENV=production

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string).
# On a serverless host (Vercel and similar), use the "Transaction pooler" (Supavisor) host/port and
# keep the pool tiny — many short-lived function instances can otherwise exhaust Postgres's connection
# limit fast:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# On a normal always-on server, the direct connection or the "Session pooler" (port 5432) work fine.
DATABASE_URL=postgresql://postgres:password@localhost:5432/anzala
PG_POOL_MAX=1

# Supabase project URL + anon key, used only by the admin panel's image upload endpoint (uploads go to
# Supabase Storage, since most hosts — Vercel included — don't offer a persistent local filesystem).
# Both are safe to expose; the anon key's Storage write policy only permits inserts into the
# "product-images" bucket, and the upload route itself is admin-session-gated.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>

# First-run admin account (only used the very first time no admin user exists — change the password after logging in).
ADMIN_EMAIL=admin@anzalachikankari.in
ADMIN_PASSWORD=ChangeMe@123

# Timezone used for "today" in the booking engine and order numbers.
STORE_TIMEZONE=Asia/Kolkata
